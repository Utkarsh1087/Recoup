# Database Connection
# SQLite is used by default for zero-setup local dev. Change to PostgreSQL if needed.
DATABASE_URL=sqlite:///./recover_ai.db

# LLM Agent Provider Config
# Options: mock, gemini, openai
LLM_PROVIDER=mock

# LLM API Keys (Only required if provider is set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Razorpay API Test Credentials (Optional)
# If omitted, RecoverAI automatically falls back to Payment Simulation Adapter
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
