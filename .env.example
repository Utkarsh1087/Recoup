# ==============================================================================
# Recoup Platform — Environment Configuration Template
# ==============================================================================
# In production, rename this file to `.env` or set these in your cloud provider
# (e.g. AWS ECS, GCP Cloud Run, Render, Railway, DigitalOcean, Kubernetes).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production                # production | staging | development
LOG_LEVEL=INFO                         # INFO | DEBUG | WARNING | ERROR

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL for Production, SQLite for Local Dev)
# ------------------------------------------------------------------------------
# Production PostgreSQL example:
# DATABASE_URL=postgresql://recoup_user:your_secure_password@postgres_host:5432/recoup_db
DATABASE_URL=sqlite:///./recover_ai.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 3. LLM AGENT PROVIDER & LIVE API KEYS
# ------------------------------------------------------------------------------
# Choose: gemini | openai | mock
LLM_PROVIDER=gemini

# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
# Model options: gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Get from: https://platform.openai.com/api-keys)
# Model options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY & WEBHOOKS
# ------------------------------------------------------------------------------
# Get from: https://dashboard.razorpay.com/app/keys
# If omitted or invalid, platform automatically uses internal sandbox simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret configured under Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. DOMAINS, NETWORKING & SECURITY CORS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

